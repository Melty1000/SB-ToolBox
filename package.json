{
  "name": "sb-toolbox",
  "version": "0.2.1",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "dev:electron": "concurrently -k \"next dev --webpack -p 3001\" \"wait-on http-get://localhost:3001/SB-ToolBox && electron .\"",
    "build": "npm run build:main && npm run build:renderer:electron",
    "build:main": "tsup electron/main.ts electron/preload.ts --format cjs --out-dir dist --clean --external electron",
    "build:renderer": "next build",
    "build:renderer:electron": "cross-env ELECTRON_BUILD=1 next build",
    "deploy": "npm run build:renderer && gh-pages -d out -t --nojekyll",
    "dist": "npm run build && electron-builder",
    "start": "next start",
    "lint": "eslint"
  },
  "build": {
    "appId": "com.antigravity.sbtoolbox",
    "productName": "SB ToolBox",
    "files": [
      "dist/**/*",
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "public/assets/icon-512.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/assets/icon.ico"
    },
    "icon": "public/assets/icon.ico",
    "publish": {
      "provider": "github",
      "owner": "Melty1000",
      "repo": "SB-ToolBox"
    }
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.3",
    "file-saver": "^2.0.5",
    "gsap": "^3.14.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.4",
    "pako": "^2.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/electron": "^1.4.38",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.19.30",
    "@types/pako": "^2.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "gh-pages": "^6.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  }
}